# 必需：登录与 GitHub 文章仓库
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_PASSWORD_HASH=sha256$replace-with-sha256-hex
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPOSITORY=owner/blog-repository

# 可选：文章位置与登录行为
GITHUB_BRANCH=main
POSTS_PATH=source/_posts
POST_EXTENSIONS=.md,.markdown
SESSION_AGE=604800
# COOKIE_SECURE=1

# 可选：AI 文章优化
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_STYLE=auto
