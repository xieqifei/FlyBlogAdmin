WORKERS=4
THREADS=4
TIMEOUT=600
# Vercel Analytics（仅 Vercel 部署默认生效）
# 不设置：在 Vercel 平台（VERCEL=1）自动开启 Web Analytics
# true  / 1 / yes  -> 强制开启（非 Vercel 需同时设置 VERCEL_ANALYTICS_ENDPOINT）
# false / 0 / no   -> 强制关闭
VERCEL_ANALYTICS=
# 非 Vercel 部署下启用 Analytics 的自定义采集端点（可选）
VERCEL_ANALYTICS_ENDPOINT=

# 可选的 AI 文章优化配置
QEXO_LLM_API_KEY=
QEXO_LLM_MODEL=
QEXO_LLM_BASE_URL=https://api.openai.com/v1
QEXO_LLM_API_STYLE=auto

# 可选：StackEdit 服务地址；私有文章建议指向自行部署的 StackEdit
QEXO_STACKEDIT_URL=https://stackedit.io/app

# 全文搜索与关系图谱的进程内索引缓存秒数（0-3600）
QEXO_SEARCH_CACHE_SECONDS=300
